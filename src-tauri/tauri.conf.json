{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notali",
  "mainBinaryName": "notali",
  "version": "1.0.0",
  "identifier": "com.notali.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "notali",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "url": "https://notali-app.vercel.app/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
